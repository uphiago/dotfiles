{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Ubuntu_small",
    "padding": {
      "left": 1,
      "right": 2,
      "top": 6
    }
  },
  "display": {
    "separator": " → ",
    "color": {
      "separator": "1"
    },
    "constants": [
      "───────────────────────────"
    ],
    "key": {
      "type": "both",
      "paddingLeft": 2
    },
    "bar": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "    {user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "┌{$1} {#1}Ubuntu • WSL2{#} {$1}┐"
    },
    "break",
    {
      "key": "OS           ",
      "keyColor": "red",
      "type": "os"
    },
    {
      "key": "Machine      ",
      "keyColor": "green",
      "type": "host",
      "format": "WSL2 {version}"
    },
    {
      "key": "Kernel       ",
      "keyColor": "magenta",
      "type": "kernel"
    },
    {
      "key": "Uptime       ",
      "keyColor": "cyan",
      "type": "uptime"
    },
    {
      "type": "packages",
      "key": "Packages     ",
      "keyColor": "white"
    },
    {
      "key": "WSLg Display ",
      "keyColor": "yellow",
      "type": "display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "key": "WM           ",
      "keyColor": "blue",
      "type": "wm",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "key": "Shell        ",
      "keyColor": "cyan",
      "type": "shell"
    },
    {
      "key": "Terminal     ",
      "keyColor": "red",
      "type": "terminal"
    },
    {
      "key": "CPU          ",
      "keyColor": "yellow",
      "type": "cpu",
      "format": "{name} ({cores-physical} cores)"
    },
    {
      "key": "GPU          ",
      "keyColor": "blue",
      "type": "gpu",
      "format": "{name} ({dedicated-total})"
    },
    {
      "key": "WSL Memory   ",
      "keyColor": "magenta",
      "type": "memory",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "swap",
      "key": "WSL Swap     ",
      "keyColor": "magenta",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "disk",
      "key": "WSL Disk     ",
      "keyColor": "cyan",
      "folders": "/",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "disk",
      "key": "Windows C:   ",
      "keyColor": "cyan",
      "folders": "/mnt/c",
      "percent": {
        "type": 3
      }
    },
    {
      "key": "Local IP     ",
      "keyColor": "red",
      "type": "localip",
      "compact": true
    },
    "break",
    {
      "type": "custom",
      "format": "└{$1}──────────────{$1}┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 34,
      "symbol": "circle"
    }
  ]
}
